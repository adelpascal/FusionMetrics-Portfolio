    "from sklearn.cluster import KMeans\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "# Fitur yang akan digunakan\n",
    "features = df_encoded[['Age', 'Experience_Years', 'Shift', 'Use_PPE', 'Fatigue_Level', 'Work_Hours']]\n",
    "\n",
    "# Standarisasi fitur\n",
    "scaler = StandardScaler()\n",
    "scaled_features = scaler.fit_transform(features)\n",
    "\n",
    "# Terapkan KMeans clustering\n",
    "kmeans = KMeans(n_clusters=3, random_state=42)\n",
    "df_encoded['Risk_Cluster'] = kmeans.fit_predict(scaled_features)\n",
    "\n",
    "# Visualisasi hasil clustering\n",
    "sns.pairplot(df_encoded, hue='Risk_Cluster', vars=['Fatigue_Level', 'Work_Hours', 'Age'], palette='Set2')\n",
    "plt.suptitle(\"Clustering Risiko Pekerja Berdasarkan Faktor K3\", y=1.02)\n",
    "plt.show()\n"
