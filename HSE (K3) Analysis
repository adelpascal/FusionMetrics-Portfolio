    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "# Untuk replikasi hasil\n",
    "np.random.seed(42)\n",
    "\n",
    "# Jumlah data\n",
    "n = 300\n",
    "\n",
    "# Buat data simulasi\n",
    "data = pd.DataFrame({\n",
    "    'Incident_Count': np.random.poisson(lam=2, size=n),\n",
    "    'Near_Miss': np.random.poisson(lam=3, size=n),\n",
    "    'Safety_Training_Hours': np.random.normal(loc=12, scale=3, size=n).round(1),\n",
    "    'PPE_Compliance_Rate': np.random.uniform(70, 100, size=n).round(2),\n",
    "    'Supervisor_Onsite': np.random.choice([0, 1], size=n, p=[0.3, 0.7]),  # 1 = ada, 0 = tidak ada\n",
    "    'Incident_Severity': np.random.choice(['Low', 'Medium', 'High'], size=n, p=[0.6, 0.3, 0.1]),\n",
    "    'Toolbox_Talk_Frequency': np.random.randint(1, 6, size=n),  # berapa kali/minggu\n",
    "    'Unsafe_Act_Rate': np.random.uniform(0, 20, size=n).round(2),  # persen\n",
    "    'Safety_Inspection_Score': np.random.normal(loc=85, scale=5, size=n).round(1),\n",
    "    'Corrective_Action_Completion': np.random.uniform(60, 100, size=n).round(2),\n",
    "    'Fatigue_Level': np.random.randint(1, 10, size=n),  # 1–10\n",
    "    'Shift_Type': np.random.choice(['Day', 'Night'], size=n, p=[0.6, 0.4]),\n",
    "    'Experience_Level': np.random.choice(['Junior', 'Mid', 'Senior'], size=n, p=[0.4, 0.4, 0.2])\n",
    "})\n",
    "\n",
    "# Tampilkan 5 baris pertama\n",
    "data.head()\n"
   ]
  },
